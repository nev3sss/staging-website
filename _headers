# Cloudflare Pages _headers — security hardening + performance
# Applied via Cloudflare Pages project settings.
# HSTS, XCTO, and Referrer-Policy are reinforced here (Cloudflare defaults may vary).

/*
  # ── Security Headers ──────────────────────────────────────
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), accelerometer=(), gyroscope=(), magnetometer=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://plausible.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests; report-uri https://nev3s.com/csp-report

  # ── Performance: Resource Hints ───────────────────────────
  Link: <https://fonts.googleapis.com>; rel=preconnect; crossorigin
  Link: <https://fonts.gstatic.com>; rel=preconnect; crossorigin
  Link: <https://plausible.io>; rel=preconnect; crossorigin

  # ── Caching ───────────────────────────────────────────────
  # Immutable assets (CSS, JS, images) — 1 year
  /assets/*
    Cache-Control: public, max-age=31536000, immutable

  # CSS and JS — 1 year (content-addressed via Cloudflare Pages deployment IDs)
  *.css
    Cache-Control: public, max-age=31536000, immutable
  *.js
    Cache-Control: public, max-age=31536000, immutable

  # HTML pages — revalidate on each request
  *.html
    Cache-Control: public, max-age=0, must-revalidate

  # Sitemap and robots — short cache
  /sitemap.xml
    Cache-Control: public, max-age=3600
  /robots.txt
    Cache-Control: public, max-age=3600

  # ── Compression ───────────────────────────────────────────
  # Cloudflare automatically applies Brotli/gzip; no explicit header needed.
